# LifeBoat Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=production

# Security - CHANGE THIS! Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-key-change-this-in-production

# Stripe (for Pro subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Create a product and price in Stripe Dashboard first
# Then get the price ID (starts with price_)
STRIPE_PRICE_ID=price_your_price_id

# SendGrid (for email notifications)
# Get API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=notifications@yourdomain.com

# Twilio (for SMS/call notifications) - Pro feature
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL (your Chrome extension ID)
# Get this after uploading to Chrome Web Store
FRONTEND_URL=chrome-extension://your-extension-id

# Database (optional - currently using in-memory)
# DATABASE_URL=postgresql://user:pass@host:5432/lifeboat
